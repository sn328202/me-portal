{
    "rewrites": [
        {
            "source": "/api/news/(.*)",
            "destination": "/api/news?endpoint=$1"
        },
        {
            "source": "/((?!assets/|api/|outfit-planner.html).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/treasury-refresh",
            "schedule": "0 14 * * *"
        }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
