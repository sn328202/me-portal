{
    "rewrites": [
        {
            "source": "/api/news/(.*)",
            "destination": "/api/news?endpoint=$1"
        },
        {
            "source": "/((?!assets/|api/|outfit-planner.html).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/treasury-refresh",
            "schedule": "0 14 * * *"
        }
    ]
}
